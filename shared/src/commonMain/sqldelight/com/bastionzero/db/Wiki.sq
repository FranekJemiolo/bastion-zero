-- Offline medical / survival wiki.
-- The same schema is produced by data_pipeline/wiki_ingestor.py (keep them in sync).

CREATE TABLE WikiArticle (
    id       INTEGER NOT NULL PRIMARY KEY,
    title    TEXT NOT NULL,
    category TEXT NOT NULL,
    body     TEXT NOT NULL
);

CREATE VIRTUAL TABLE WikiFts USING fts5(
    title,
    body
);

insertArticle:
INSERT OR REPLACE INTO WikiArticle(id, title, category, body) VALUES (?, ?, ?, ?);

deleteFts:
DELETE FROM WikiFts WHERE rowid = ?;

insertFts:
INSERT INTO WikiFts(rowid, title, body) VALUES (?, ?, ?);

articleById:
SELECT id, title, category, body FROM WikiArticle WHERE id = ?;

articleCount:
SELECT COUNT(*) FROM WikiArticle;

listByCategory:
SELECT id, title, category, body FROM WikiArticle WHERE category = ? ORDER BY title;

listAll:
SELECT id, title, category, body FROM WikiArticle ORDER BY title;

search:
SELECT a.id, a.title, a.category, a.body
FROM WikiArticle a
WHERE a.id IN (
    SELECT rowid FROM WikiFts WHERE WikiFts MATCH ?
)
LIMIT ?;
