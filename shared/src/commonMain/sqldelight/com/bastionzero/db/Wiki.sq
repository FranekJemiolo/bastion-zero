-- Offline medical / survival wiki database schema.
-- Pure SQLite compliant schema compatible across JVM, Android, iOS, and Native drivers.

CREATE TABLE WikiArticle (
    id       INTEGER NOT NULL PRIMARY KEY,
    title    TEXT NOT NULL,
    category TEXT NOT NULL,
    body     TEXT NOT NULL
);

CREATE TABLE WikiFts (
    id       INTEGER NOT NULL PRIMARY KEY,
    title    TEXT NOT NULL,
    body     TEXT NOT NULL
);

insertArticle:
INSERT OR REPLACE INTO WikiArticle(id, title, category, body) VALUES (?, ?, ?, ?);

deleteFts:
DELETE FROM WikiFts WHERE id = ?;

insertFts:
INSERT OR REPLACE INTO WikiFts(id, title, body) VALUES (?, ?, ?);

articleById:
SELECT id, title, category, body FROM WikiArticle WHERE id = ?;

articleCount:
SELECT COUNT(*) FROM WikiArticle;

listByCategory:
SELECT id, title, category, body FROM WikiArticle WHERE category = ? ORDER BY title;

listAll:
SELECT id, title, category, body FROM WikiArticle ORDER BY title;

search:
SELECT id, title, category, body
FROM WikiArticle
WHERE title LIKE ('%' || :query || '%') OR body LIKE ('%' || :query || '%')
LIMIT :limit;
